---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Section from "../../components/ui/Section.astro";
import { serviceAreas } from "../../data/service-areas";
import { MapPin, Phone, CheckCircle2 } from "lucide-react";

export const prerender = true;

export function getStaticPaths() {
    return serviceAreas.map((area) => ({
        params: { slug: area.slug },
        props: { area },
    }));
}

const { area } = Astro.props;

const title = `${area.name} House Cleaning Services | Home Cleaning & Co`;
const description = `Home Cleaning & Co provides house cleaning services in ${area.name}, FL, including ZIP codes ${area.zipCodes.join(", ")}.`;
---

<Layout title={title} description={description}>
    <Header />

    <main class="pt-28 md:pt-36">
        <Section class="bg-background-mint py-16 md:py-24">
            <div class="max-w-4xl mx-auto text-center">
                <span class="inline-flex items-center gap-2 rounded-full bg-white border border-border-light px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-text-600 mb-6">
                    <MapPin className="w-4 h-4 text-primary" />
                    Service Area Page
                </span>
                <h1 class="text-4xl md:text-6xl font-bold text-secondary tracking-tight mb-6">
                    House Cleaning in <span class="text-primary">{area.name}</span>, FL
                </h1>
                <p class="text-lg text-text-light leading-relaxed max-w-3xl mx-auto">
                    {area.summary} We help homeowners, vacation rental hosts, and
                    busy families keep their spaces consistently clean with reliable
                    communication and clear pricing.
                </p>
                <div class="mt-10 flex flex-col sm:flex-row justify-center gap-4">
                    <a href="/#quote" class="inline-flex items-center justify-center rounded-full bg-primary px-8 py-4 text-white font-bold shadow-xl shadow-primary/20 hover:bg-primary-dark transition-colors">
                        Get My Quote
                    </a>
                    <a href="tel:9543933479" class="inline-flex items-center justify-center gap-2 rounded-full border border-border-light bg-white px-8 py-4 font-bold text-secondary shadow-sm hover:border-primary/30 transition-colors">
                        <Phone className="w-4 h-4 text-primary" />
                        Call (954) 393-3479
                    </a>
                </div>
            </div>
        </Section>

        <Section class="py-16 md:py-20">
            <div class="grid gap-8 lg:grid-cols-[1.3fr_0.7fr]">
                <div class="rounded-3xl border border-border-light bg-white p-8 shadow-sm">
                    <h2 class="text-3xl font-bold text-secondary mb-4">
                        Cleaning Services Available in {area.name}
                    </h2>
                    <p class="text-text-light leading-relaxed mb-6">
                        We offer recurring house cleaning, deep cleaning, move-in and
                        move-out cleaning, Airbnb turnover cleaning, and post-construction
                        cleanup for homes in {area.name}. Every visit includes
                        professional supplies, dependable arrival windows, and a
                        satisfaction-focused approach.
                    </p>
                    <div class="grid gap-4 md:grid-cols-2">
                        {[
                            "Recurring maintenance cleaning",
                            "Deep cleaning",
                            "Move-in and move-out cleaning",
                            "Airbnb turnover cleaning",
                            "Post-construction cleanup",
                            "Free estimate requests",
                        ].map((item) => (
                            <div class="flex items-start gap-3 rounded-2xl bg-surface p-4">
                                <CheckCircle2 className="mt-0.5 h-5 w-5 text-primary shrink-0" />
                                <span class="font-medium text-secondary">{item}</span>
                            </div>
                        ))}
                    </div>
                </div>

                <div class="space-y-6">
                    <div class="rounded-3xl border border-border-light bg-white p-8 shadow-sm">
                        <h2 class="text-2xl font-bold text-secondary mb-4">
                            ZIP Codes in {area.name}
                        </h2>
                        <div class="flex flex-wrap gap-3">
                            {area.zipCodes.map((zipCode) => (
                                <span class="rounded-full border border-primary/20 bg-primary/5 px-4 py-2 text-sm font-semibold text-secondary">
                                    {zipCode}
                                </span>
                            ))}
                        </div>
                    </div>

                    <div class="rounded-3xl border border-border-light bg-white p-8 shadow-sm">
                        <h2 class="text-2xl font-bold text-secondary mb-4">
                            Nearby Areas We Cover
                        </h2>
                        <ul class="space-y-3">
                            {area.nearbyAreas.map((nearbyArea) => (
                                <li class="flex items-start gap-3 text-text-light">
                                    <MapPin className="mt-1 h-4 w-4 text-primary shrink-0" />
                                    <span>{nearbyArea}</span>
                                </li>
                            ))}
                        </ul>
                    </div>
                </div>
            </div>
        </Section>
    </main>

    <Footer />
</Layout>
